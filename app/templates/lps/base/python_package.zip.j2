{# =====================================================================
   Template: python_package.zip.j2
   Generates the ``pyproject.toml`` for a generated Python project.
   The "zip" suffix is a misnomer from the spec — it really is a
   pyproject.toml content. The user-facing product ends up packaged
   as a .zip when they click "Gerar Produto".
   ===================================================================== #}
[build-system]
requires = ["setuptools>=68", "wheel"]
build-backend = "setuptools.build_meta"

[project]
name = "{{ component.name | lower | replace(' ', '-') }}"
version = "0.1.0"
description = "{{ component.description or 'Generated by ArchExplorer LPS.' }}"
readme = "README.md"
requires-python = ">=3.10"
license = { text = "Apache-2.0" }
authors = [
    { name = "ArchExplorer LPS", email = "noreply@example.com" },
]
keywords = ["archexplorer", "lps", "feature-model"]

dependencies = [
{%- if component.metadata.get('requirements') %}
{%- for req in component.metadata.requirements %}
    "{{ req }}",
{%- endfor %}
{%- else %}
    # add your runtime dependencies here
{%- endif %}
]

[project.optional-dependencies]
dev = [
    "pytest>=8",
    "pytest-cov>=5",
]

[project.scripts]
{{ component.name | lower | replace(' ', '-') }} = "{{ component.name | lower | replace(' ', '-') }}.__main__:main"

[tool.setuptools.packages.find]
where = ["src"]

[tool.pytest.ini_options]
testpaths = ["tests"]
addopts = "-v --tb=short"
