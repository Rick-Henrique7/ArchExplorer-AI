# ============================================================
# ArchExplorer AI — .gitignore
# Python + PySide6 + IDEs + Windows
# ============================================================

# --- Python bytecode and caches --------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
*.whl

# --- Virtual environments --------------------------------------
.venv/
venv/
env/
ENV/
.python-version

# --- Test / coverage artifacts ---------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.nox/
.cache

# --- Type checking / linters -----------------------------------
.mypy_cache/
.ruff_cache/
.dmypy.json
dmypy.json

# --- Build / distribution --------------------------------------
build/
dist/
develop-eggs/
downloads/
eggs/
sdist/
wheels/
pip-log.txt
pip-delete-this-directory.txt

# --- IDEs -------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# --- Windows ---------------------------------------------------
Thumbs.db
ehthumbs.db
ehthumbs_view.db
Desktop.ini
$RECYCLE.BIN/

# --- Project-local ---------------------------------------------
*.log
*.tmp
*.bak
.tmp_*.py
screenshot-*.png
.session/
